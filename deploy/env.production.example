# Copia questo file come .env nella root del progetto sul server
# e compila tutti i valori

# Database — usa questa stringa esatta, "db" è il nome del container Docker
DATABASE_URL=postgresql://ilsa_user:METTI_PASSWORD_DB_QUI@db:5432/ilsa_crm

# Stessa password usata in docker-compose.yml come DB_PASSWORD
DB_PASSWORD=METTI_PASSWORD_DB_QUI

# Chiave segreta per i JWT — stringa lunga e casuale, es. genera con:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=METTI_CHIAVE_SEGRETA_QUI

# Minuti di validità del token JWT (480 = 8 ore)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Resend — per le email dei reminder
RESEND_API_KEY=re_XXXXXXXXXXXX
RESEND_FROM=ILSA CRM <noreply@tuodominio.it>

# CORS — URL del frontend (senza slash finale)
ALLOWED_ORIGINS=https://tuofrontend.netlify.app,https://eventuale-altro-dominio.it
